{
  "name": "craftcms/contact-form",
  "description": "Add a simple contact form to your Craft CMS site",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "contact",
    "craftcms",
    "form",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/contact-form/issues?state=open",
    "source": "https://github.com/craftcms/contact-form",
    "docs": "https://github.com/craftcms/contact-form/blob/4.x/README.md",
    "rss": "https://github.com/craftcms/contact-form/commits/4.x.atom"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-beta.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "larastan/larastan": "^3.13",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "laravel/pint": "^1.22"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\ContactForm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\ContactForm\\Tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Contact Form",
    "handle": "contact-form",
    "class": "CraftCms\\ContactForm\\Plugin",
    "documentationUrl": "https://github.com/craftcms/contact-form/blob/4.x/README.md"
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
